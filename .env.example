# NextAuth & Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-change-me-in-production
JWT_SECRET=your-jwt-secret-change-me-in-production

# Database (Postgres via Supabase or other provider)
DATABASE_URL=postgresql://user:password@host:5432/mediasky

# Site Config
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Flutterwave MoMo Configuration
FLUTTERWAVE_SECRET_KEY=flw_test_your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=pk_test_your_flutterwave_public_key
FLUTTERWAVE_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary (for media uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Admin Credentials (for initial setup only)
ADMIN_EMAIL=admin@mediasky.com
ADMIN_PASSWORD=change_me_in_production
